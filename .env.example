# Copy to .env and adjust. The defaults below match `docker compose up -d`.

# ---- database ----------------------------------------------------------------
# Connect as sp_app (NOT the `sp` superuser) — superusers bypass row-level
# security, which would silently disable every tenant-isolation policy.
DATABASE_URL=postgresql+psycopg://sp_app:sp_dev_password@localhost:5432/strava_premium

# ---- redis (celery broker + cache + rate-limit buckets) ----------------------
REDIS_URL=redis://localhost:6379/0

# ---- object storage (MinIO locally, R2/S3 in the cloud) ----------------------
S3_ENDPOINT=http://localhost:9000
# What the BROWSER should use when following a presigned URL. Differs from
# S3_ENDPOINT when the API runs inside Docker and the browser doesn't.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=strava-premium
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---- security ----------------------------------------------------------------
# Generate real values for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# "lax" unless frontend and API are on totally unrelated domains (a free-tier
# test deploy with no custom domain) — Lax cookies aren't sent on cross-site
# fetch/XHR, only "none" fixes that. Leave at "lax" once they share a domain.
COOKIE_SAMESITE=lax
SESSION_SECRET=dev-only-not-a-real-secret-change-me
# Fernet key for encrypting Strava tokens at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- app ---------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
COOKIE_SECURE=false

# ---- Google sign-in (optional locally; the button hides when unset) ----------
# https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Strava (optional for v1 local; needed to sync new activities) -----------
# https://www.strava.com/settings/api
#   Authorization Callback Domain: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=dev-verify-token
